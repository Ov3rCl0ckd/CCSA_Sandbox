
#!/usr/sbin/nft -f
#
# round1.nft - SYN-flood defense for the SAME-SOURCE-IP attack.
#
#   Attack : syn bad <attacker_ip> 10.2.0.4 80 <count>    (one real source IP)
#   Load   : sudo nft -f round1.nft        (or just:  sudo ./round1.sh)
#   Remove : sudo nft delete table inet defense   (or:  sudo ./flush.sh)
#
# WHAT IT DOES
#   * learns which source IP is flooding and BANS it for 60s
#   * rate-limits every source to 20 SYN/s as a backstop
#
#   This stops the "bad" attack because every packet comes from the SAME,
#   REAL source IP -- so the per-source buckets fill and the ban sticks.
#
# TUNABLES
#   ban trigger : >50 SYN/s (burst 100)  -> rule (b)  "syn_block"
#   ban length  : for as long as this ruleset stays loaded (NO timeout)
#   rate limit  : >20 SYN/s (burst 40)    -> rule (c)  "syn_per_src"

table inet defense {

    # dynamic ban list (populated by rule (b) below).
    # NO timeout: once a source is banned it stays banned for the whole
    # session -- i.e. until you run ./flush.sh or reload ./round1.sh.
    set synflood {
        type ipv4_addr
        flags dynamic
        size 65535
    }

    chain input {
        type filter hook input priority filter; policy accept;

        # never lock ourselves out
        iif lo accept
        ct state established,related accept

        # ==============================================================
        # SAME-IP DEFENSE
        # ORDER MATTERS: ban list first, then the trigger, then the limiter.
        # If the limiter ran first it would drop the packets and the >50/s
        # trigger would never see them (ban list would stay empty).
        # ==============================================================

        # (a) anything already banned -> hard drop
        ip saddr @synflood counter drop

        # (b) a source heavier than 50 SYN/s gets banned (stays banned)
        tcp dport 80 tcp flags syn \
            meter syn_block { ip saddr limit rate over 50/second burst 100 packets } \
            add @synflood { ip saddr } counter

        # (c) backstop: cap every source at 20 SYN/s
        tcp dport 80 tcp flags syn \
            meter syn_per_src { ip saddr limit rate over 20/second burst 40 packets } \
            counter drop

        # the game itself
        tcp dport 80 accept

        # keep the rest of the VM reachable (ssh, dhcp, ...)
        ct state new accept
    }
}
